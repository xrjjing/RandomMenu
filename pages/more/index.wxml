<view class="page more-page">
  <!-- 智能功能入口(仅家庭管理员可见) -->
  <view class="card more-card">
    <view class="section-title">智能</view>
    <t-cell-group>
      <t-cell
        wx:if="{{isAdmin}}"
        title="AI 管理"
        note="生图 · 生文 · 补图"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="onAiSettings"
      />
      <t-cell
        wx:if="{{isAdmin}}"
        title="提示词管理"
        note="各 AI 功能的提示词"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="onAiPrompts"
      />
    </t-cell-group>
  </view>

  <!-- 数据与管理入口 -->
  <view class="card more-card">
    <view class="section-title">管理</view>
    <t-cell-group>
      <t-cell
        title="原料库"
        note="管理菜谱用到的原料"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goIngredient"
      />
      <t-cell
        wx:if="{{isAdmin}}"
        title="家庭与成员管理"
        note="家庭别名 · 成员归属 · 未分配池"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goFamily"
      />
    </t-cell-group>
  </view>

  <t-toast id="t-toast" />
</view>
