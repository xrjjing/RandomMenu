<view class="page more-page">
  <!-- 功能入口列表 -->
  <view class="card more-card">
    <t-cell-group>
      <t-cell
        title="原料库"
        note="管理菜谱用到的原料"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goIngredient"
      />
      <t-cell
        title="初始化内置菜谱"
        note="导入系统预置的家常菜与饮品 · 非必要不使用"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goImportBuiltin"
      />
      <t-cell
        title="上传内置图到云"
        note="把内置菜图片存到云端 · 非必要不使用"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goUploadBuiltinImages"
      />
      <!-- 管理入口仅家庭管理员可见可用 -->
      <t-cell
        wx:if="{{isAdmin}}"
        title="家庭与成员管理"
        note="家庭别名 · 成员归属 · 未分配池"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="goFamily"
      />
      <!-- AI 设置入口仅家庭管理员可见 -->
      <t-cell
        wx:if="{{isAdmin}}"
        title="AI 设置"
        note="生图 · 生文开关"
        arrow="{{true}}"
        hover="{{true}}"
        bind:click="onAiSettings"
      />
    </t-cell-group>
  </view>
  <t-toast id="t-toast" />
</view>
