<view class="page home-page">
  <!-- 昵称引导弹层(未注册成员首次进入弹出;可关闭不强制,未注册照常走未分配池) -->
  <t-popup visible="{{nicknamePopupVisible}}" placement="bottom" bind:visible-change="onNicknameVisibleChange">
    <view slot="content" class="nickname-popup">
      <view class="nickname-title">给自己起个昵称</view>
      <view class="nickname-desc">家人可在「更多 › 家庭与成员管理」里看到你</view>
      <t-input
        type="nickname"
        value="{{nicknameInput}}"
        placeholder="给自己起个昵称"
        maxlength="20"
        bind:change="onNicknameInput"
      />
      <t-button block theme="primary" bind:tap="onNicknameConfirm">确定</t-button>
      <view class="nickname-skip" bind:tap="onNicknameClose">暂不设置</view>
    </view>
  </t-popup>

  <!-- 今明已定卡:F25 三分组(今天/明天/后天),空组整组不渲染,全空显示空态;
       行点击跳详情,每行「原料」弹层;撤销按钮只在今天组展示 -->
  <view class="card today-card">
    <view class="card-title">今明已定</view>
    <view wx:if="{{todayTotal === 0}}" class="today-empty">今天还没定，选一道吧 👇</view>
    <block wx:else>
      <block wx:for="{{todayGroups}}" wx:for-item="group" wx:key="key">
        <view wx:if="{{group.rows.length > 0}}" class="today-group">
          <view class="today-group-title">{{group.label}}</view>
          <view
            class="today-row"
            wx:for="{{group.rows}}"
            wx:key="_id"
            hover-class="today-row-hover"
            bind:tap="onTodayRowTap"
            data-id="{{item.dishId}}"
          >
            <view class="today-info">
              <text class="today-name">{{item.dishName}}</text>
              <text class="today-time">{{item.time}}</text>
            </view>
            <view class="today-actions">
              <!-- 原料文字按钮:catch:tap 阻止冒泡,不触发行跳详情 -->
              <view class="today-ing-btn" catch:tap="onIngredientsTap" data-gkey="{{group.key}}" data-index="{{index}}">原料</view>
              <!-- 今天组:撤销(组级,删当天最后一条);明天/后天组:行级删除 -->
              <view wx:if="{{group.key === 'today'}}" class="today-undo" catch:tap="onUndoTap">撤销</view>
              <view wx:else class="today-undo" catch:tap="onDeleteTap" data-gkey="{{group.key}}" data-index="{{index}}">删除</view>
            </view>
          </view>
        </view>
      </block>
    </block>
  </view>

  <!-- AI 今日简报卡(当天有效,brie 分包页生成后写 storage,首页只用读展示;点击进分包重新生成);
       首次使用无简报时展示引导卡(D #5:否则入口被 briefCard 为空的 wx:if 完全遮住) -->
  <view wx:if="{{briefCard}}" class="card brief-card" hover-class="brief-card-hover" bind:tap="onAiBrief">
    <view class="card-title brief-card-title">✨ AI 今日简报</view>
    <view class="brief-card-text">{{briefCard.text}}</view>
    <view class="brief-card-more">查看 / 重新生成 ›</view>
  </view>
  <view wx:else class="card brief-card brief-guide" hover-class="brief-card-hover" bind:tap="onAiBrief">
    <view class="card-title brief-card-title">✨ AI 今日简报</view>
    <view class="brief-card-text brief-guide-text">生成今天的一句话做饭小结，一眼看懂今天的安排</view>
    <view class="brief-card-more">立即生成 ›</view>
  </view>

  <!-- 冰箱里有什么:横向 chips 多选原料(排除调料),顶部小搜索防抖 300ms 过滤 -->
  <view class="card fridge-card">
    <view class="card-title">冰箱里有什么</view>
    <view class="fridge-search">
      <t-search
        value="{{ingredientKeyword}}"
        placeholder="搜菜名 / 原料"
        shape="round"
        t-class="fridge-search-input"
        bind:change="onIngredientSearch"
        bind:clear="onIngredientSearchClear"
      />
    </view>
    <scroll-view wx:if="{{ingredientChips.length > 0}}" scroll-x class="chip-scroll" enhanced show-scrollbar="{{false}}">
      <view class="chip-list">
        <view
          class="chip {{item.active ? 'chip-active' : ''}}"
          wx:for="{{ingredientChips}}"
          wx:key="name"
          bind:tap="onIngredientTap"
          data-name="{{item.name}}"
        >{{item.name}}</view>
      </view>
    </scroll-view>
    <view wx:else class="fridge-empty">冰箱空空如也，先去原料库添加原料吧</view>
  </view>

  <!-- 匹配结果:模式切换(t-switch)+ 分类入口 + 卡片流 -->
  <view class="match-header">
    <view class="match-title">匹配结果</view>
    <view class="mode-row">
      <text class="mode-label">{{completeMode ? '完全匹配' : '有交集即可'}}</text>
      <t-switch value="{{completeMode}}" bind:change="onModeChange" />
    </view>
  </view>

  <!-- 分类入口 chips:未选原料时展示(全部/餐食/饮品),点击进入对应分类浏览(再点取消回到引导态) -->
  <view wx:if="{{selectedNames.length === 0}}" class="match-cats">
    <view class="chip {{matchSearched && matchCategory === '' ? 'chip-active' : ''}}" data-value="" bind:tap="onCategoryTap">全部</view>
    <view class="chip {{matchSearched && matchCategory === 'meal' ? 'chip-active' : ''}}" data-value="meal" bind:tap="onCategoryTap">餐食</view>
    <view class="chip {{matchSearched && matchCategory === 'drink' ? 'chip-active' : ''}}" data-value="drink" bind:tap="onCategoryTap">饮品</view>
  </view>

  <!-- 首屏骨架屏:今日卡 + 冰箱 chips 区组合(数据到位后隐藏;翻页/静默刷新不显示) -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="card skeleton-card">
      <t-skeleton row-col="{{todaySkeletonRowCol}}" animation="gradient" />
    </view>
    <view class="card skeleton-card">
      <t-skeleton row-col="{{fridgeSkeletonRowCol}}" animation="gradient" />
    </view>
  </view>

  <!-- 未搜索引导态:无关键词、未选原料且未选分类时,不展示菜品列表,仅文案引导 + 分类入口 -->
  <view wx:elif="{{selectedNames.length === 0 && !matchSearched && !hasDishKeyword}}" class="match-guide">
    <view class="match-guide-text">选择原料，或让我们抽一个</view>
  </view>

  <!-- 空态:区分「无菜谱(去初始化)」与「选了原料但无匹配/分类无菜」 -->
  <view wx:elif="{{matchList.length === 0}}" class="empty-wrap">
    <t-empty description="{{matchEmptyText}}">
      <view slot="action" class="empty-action">
        <t-button wx:if="{{noDishes}}" size="small" theme="primary" bind:tap="goMore">去初始化</t-button>
      </view>
    </t-empty>
  </view>

  <!-- 匹配卡片流:复用菜谱列表页卡片风格(首图/emoji、菜名、原料标签、徽章、内置角标)+ 匹配度百分比 -->
  <view wx:else class="match-list">
    <view
      class="card match-card"
      wx:for="{{matchList}}"
      wx:key="_id"
      hover-class="match-card-hover"
      bind:tap="onDishTap"
      data-id="{{item._id}}"
      data-name="{{item.name}}"
    >
      <!-- 首图:有图用 fileID 渲染,无图显示分类 emoji 大字(浅橙底圆角) -->
      <view class="dish-cover">
        <image wx:if="{{item.cover}}" class="dish-cover-img" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="dish-cover-emoji">{{item.emoji}}</view>
        <!-- 内置角标 -->
        <view wx:if="{{item.isBuiltin}}" class="builtin-badge">内置</view>
      </view>
      <view class="dish-info">
        <view class="dish-name-row">
          <text class="dish-name">{{item.name}}</text>
          <!-- 匹配度百分比徽章(未选原料浏览全部时不显示) -->
          <text wx:if="{{item.score}}" class="score-badge">{{item.score}}</text>
        </view>
        <!-- 原料名标签:前 4 个 + 其余数量 -->
        <view class="dish-ingredients">
          <text class="ing-tag" wx:for="{{item.ingredientTags}}" wx:for-item="ing" wx:key="*this">{{ing}}</text>
          <text wx:if="{{item.extraCount > 0}}" class="ing-more">+{{item.extraCount}}</text>
        </view>
        <!-- 时间 / 难度小徽章 -->
        <view class="dish-meta">
          <text wx:if="{{item.cookTime}}" class="meta-badge">⏱ {{item.cookTime}}</text>
          <text wx:if="{{item.difficulty}}" class="meta-badge">{{item.difficulty}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 翻页 footer:未选原料浏览全部时触底翻页 -->
  <view wx:if="{{!loading && matchList.length > 0}}" class="list-footer">
    <text wx:if="{{matchLoadingMore}}">加载中...</text>
    <text wx:elif="{{!matchHasMore}}">没有更多了</text>
  </view>

  <!-- AI 推荐入口按钮:fixed 悬浮于转盘按钮上方,同样不占文档流(仅跳转分包页) -->
  <view class="ai-recommend-btn" bind:tap="onAiRecommend">✨ AI 推荐</view>

  <!-- 转盘入口按钮:fixed 悬浮于右下角(参照菜单页 ➕ 先例),不占文档流,
       列表再长也不会被顶到页面底端被自定义 tabBar 盖住;候选为空时禁用置灰并提示 -->
  <view class="wheel-btn {{wheelDisabled ? 'wheel-btn-disabled' : ''}}" bind:tap="onWheelBtnTap">🎰 {{wheelDisabled ? '先选几道菜或添加菜谱' : '随机转盘'}}</view>

  <!-- 随机转盘半屏弹层:底部弹出,内嵌 spin-wheel 组件(items=当前候选) -->
  <t-popup
    visible="{{wheelVisible}}"
    placement="bottom"
    bind:visible-change="onWheelVisibleChange"
  >
    <!-- 内容随 wheelVisible 整体销毁:popup 关闭做下滑动画期间,同层渲染的 type=2d canvas 在
         macOS 工具上不跟随 transform,会原地悬浮残留 0.5-1s;关闭即销毁内容(canvas 瞬间消失),
         popup 空壳照常播关闭动画;重新打开时组件重建 → ready → initCanvasWithRetry(F14 一次成功)
         → items observer 重绘盘面,组件内部状态全重置无残留 -->
    <view slot="content" class="wheel-popup" wx:if="{{wheelVisible}}">
      <view class="wheel-popup-header">
        <view class="wheel-popup-title">随机转盘</view>
        <view class="wheel-popup-count">候选 {{candidates.length}} 道，最多展示 12 道</view>
        <!-- 标题栏关闭:与点遮罩关闭等价(回写 wheelVisible 才能真正关闭 popup) -->
        <view class="wheel-popup-close" hover-class="wheel-popup-close-hover" bind:tap="closeWheel">✕</view>
      </view>
      <spin-wheel id="wheel" items="{{candidates}}" bind:spinstart="onSpinStart" bind:spinend="onSpinEnd" />
      <t-button block theme="primary" disabled="{{wheelSpinning}}" bind:tap="onStartSpin">
        {{wheelSpinning ? '旋转中…' : '开始旋转'}}
      </t-button>
      <view class="wheel-popup-tip">也可点击转盘中央「转」开始；转出后点「就吃它了」直接落账</view>
    </view>
  </t-popup>

  <!-- 转盘结果弹层:「就吃它了」落账 /「换一个」重转;点遮罩可关闭回到转盘
       z-index 12000:dialog 内部也是 t-popup,默认层级与转盘 popup 同为 11500,
       结果弹层会与转盘平叠(实测被转盘盖住看不见);显式抬高一层保证结果始终盖在转盘之上 -->
  <!-- 转盘结果弹层:F25 改为 t-popup(与落账确认弹层同风格),加今天/明天/后天三选;
       z-index 12000:结果弹层须始终盖在转盘之上(转盘 popup 默认 11500) -->
  <t-popup
    visible="{{wheelResultVisible}}"
    placement="bottom"
    z-index="{{12000}}"
    bind:visible-change="onWheelResultVisibleChange"
  >
    <view slot="content" class="confirm-popup">
      <view class="confirm-title">今晚就吃</view>
      <view class="confirm-dish">{{wheelResultText}}</view>
      <view class="date-option-row">
        <view
          wx:for="{{dateOptions}}"
          wx:key="key"
          class="date-option {{pendingDate === item.key ? 'date-option-active' : ''}}"
          data-key="{{item.key}}"
          bind:tap="onDateOptionTap"
        >{{item.label}}</view>
      </view>
      <view class="confirm-btn-row">
        <t-button block theme="light" bind:tap="onWheelAgain">换一个</t-button>
        <t-button block theme="primary" bind:tap="onWheelConfirm">就吃它了</t-button>
      </view>
    </view>
  </t-popup>

  <!-- F25 「就做这道?」确认落账弹层:菜名 + 今天/明天/后天三选 + 取消/确认 -->
  <t-popup
    visible="{{dishDialogVisible}}"
    placement="bottom"
    bind:visible-change="onDishVisibleChange"
  >
    <view slot="content" class="confirm-popup">
      <view class="confirm-title">就做这道？</view>
      <view class="confirm-dish">{{pendingDishText}}</view>
      <view class="date-option-row">
        <view
          wx:for="{{dateOptions}}"
          wx:key="key"
          class="date-option {{pendingDate === item.key ? 'date-option-active' : ''}}"
          data-key="{{item.key}}"
          bind:tap="onDateOptionTap"
        >{{item.label}}</view>
      </view>
      <view class="confirm-btn-row">
        <t-button block theme="light" bind:tap="onDishCancel">取消</t-button>
        <t-button block theme="primary" bind:tap="onDishConfirm">确定</t-button>
      </view>
    </view>
  </t-popup>

  <!-- 撤销确认弹层:文案写清撤销的是当天最后一条记录(F25 仍仅指今天) -->
  <t-dialog
    visible="{{undoDialogVisible}}"
    title="撤销记录"
    content="将撤销今天最后一条记录「{{undoName}}」，确定吗？"
    confirm-btn="{{undoConfirmBtn}}"
    cancel-btn="取消"
    bind:confirm="onUndoConfirm"
    bind:cancel="onUndoCancel"
    bind:close="onUndoCancel"
  />

  <!-- F25 删除确认弹层(明天/后天组行级删除):文案带目标日期,避免误删 -->
  <t-dialog
    visible="{{deleteDialogVisible}}"
    title="删除记录"
    content="将删除{{deleteRow.dateLabel}}的「{{deleteRow.dishName}}」，确定吗？"
    confirm-btn="{{undoConfirmBtn}}"
    cancel-btn="取消"
    bind:confirm="onDeleteConfirm"
    bind:cancel="onDeleteCancel"
    bind:close="onDeleteCancel"
  />

  <!-- F25 原料查看弹层:标题=菜名,内容=该行原料逐行;空数组显示提示文案 -->
  <t-popup
    visible="{{ingredientsPopupVisible}}"
    placement="bottom"
    bind:visible-change="onIngredientsVisibleChange"
  >
    <view slot="content" class="confirm-popup">
      <view class="confirm-title">{{ingredientsPopupName}}</view>
      <view wx:if="{{ingredientsPopupList.length === 0}}" class="ingredients-empty">暂无原料记录</view>
      <view wx:else class="ingredients-list">
        <view class="ingredients-item" wx:for="{{ingredientsPopupList}}" wx:key="*this">{{item}}</view>
      </view>
      <t-button block theme="light" bind:tap="onIngredientsClose">关闭</t-button>
    </view>
  </t-popup>

  <!-- 统一轻提示 -->
  <t-toast id="t-toast" />
</view>
