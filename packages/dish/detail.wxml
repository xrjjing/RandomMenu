<view class="page detail-page">
  <!-- 首屏加载态 -->
  <view wx:if="{{loading}}" class="detail-loading">
    <t-loading theme="spinner" size="64rpx" text="加载中..." />
  </view>

  <block wx:elif="{{dish}}">
    <!-- 图片区:有图轮播(fileID 直接渲染),无图显示分类 emoji 占位(浅橙底圆角) -->
    <view class="detail-cover">
      <t-swiper
        wx:if="{{images.length > 0}}"
        class="cover-swiper"
        list="{{images}}"
        height="360"
        navigation="{{true}}"
        autoplay="{{false}}"
        loop="{{false}}"
        bind:click="onImagePreview"
      />
      <view wx:else class="detail-cover-emoji">{{emoji}}</view>
      <!-- 内置角标 -->
      <view wx:if="{{dish.isBuiltin}}" class="builtin-badge">内置</view>
    </view>

    <!-- 头部卡:菜名 + 细分标签 + 时间/难度徽章 -->
    <view class="card detail-head">
      <view class="dish-name">{{dish.name}}</view>
      <view wx:if="{{dish.tags.length}}" class="tag-list">
        <t-tag
          wx:for="{{dish.tags}}"
          wx:key="*this"
          size="small"
          variant="light"
          theme="primary"
        >{{item}}</t-tag>
      </view>
      <view class="meta-row">
        <text wx:if="{{dish.cookTime}}" class="meta-badge">⏱ {{dish.cookTime}}</text>
        <text wx:if="{{dish.difficulty}}" class="meta-badge">{{dish.difficulty}}</text>
      </view>
    </view>

    <!-- 原料卡:逐行「名称 + 用量」,调料行名称后加灰字标记 -->
    <view class="card detail-section">
      <view class="section-title">原料</view>
      <view wx:if="{{ingredients.length === 0}}" class="section-empty">暂无原料</view>
      <view wx:else class="ingredient-list">
        <view class="ingredient-row" wx:for="{{ingredients}}" wx:key="name">
          <view class="ingredient-name">
            {{item.name}}<text wx:if="{{item.isSeasoning}}" class="seasoning-mark">(调料)</text>
          </view>
          <view class="ingredient-amount">{{item.amount || '适量'}}</view>
        </view>
      </view>
    </view>

    <!-- AI 小贴士入口(生文开启时显示) -->
    <view wx:if="{{textEnabled}}" class="card detail-section tips-entry" bind:tap="onTipsTap">
      <view class="tips-entry-main">
        <text class="tips-entry-emoji">✨</text>
        <text class="tips-entry-text">AI 小贴士（替代 / 口味调整）</text>
      </view>
      <text class="tips-entry-arrow">›</text>
    </view>

    <!-- 做法卡:有序步骤列表(序号圆点 + 文本),为空显示引导文案 -->
    <view class="card detail-section">
      <view class="section-title">做法</view>
      <view wx:if="{{dish.steps.length === 0}}" class="section-empty">暂无做法，快来补充～</view>
      <view wx:else class="step-list">
        <view class="step-row" wx:for="{{dish.steps}}" wx:key="*this">
          <view class="step-index">{{index + 1}}</view>
          <view class="step-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏:主按钮「编辑」/ 次按钮「删除」 -->
    <view class="detail-actions">
      <t-button class="action-btn" theme="primary" variant="outline" bind:tap="goEdit">编辑</t-button>
      <t-button class="action-btn" theme="danger" variant="outline" bind:tap="onDeleteTap">删除</t-button>
    </view>
  </block>

  <!-- 第一层删除确认弹窗(现有):确定后进入第二层,不直接删除 -->
  <t-dialog
    visible="{{deleteVisible}}"
    title="删除菜品"
    content="删除后不可恢复，历史做菜记录保留。确定删除「{{dish.name}}」吗？"
    confirm-btn="删除"
    cancel-btn="取消"
    bind:confirm="onDeleteConfirm"
    bind:cancel="onDeleteCancel"
  />

  <!-- 第二层删除再次确认弹窗(防误删):第一层确定后弹出,此层确定才执行删除 -->
  <t-dialog
    visible="{{deleteReconfirmVisible}}"
    title="再次确认"
    content="确定要删除『{{dish.name}}』吗？"
    confirm-btn="{{deleteReconfirmBtn}}"
    cancel-btn="取消"
    bind:confirm="onDeleteReconfirmConfirm"
    bind:cancel="onDeleteReconfirmCancel"
  />

  <!-- AI 小贴士弹层:底部弹出,可输问题(可跳过) -->
  <t-popup
    visible="{{tipsPopupVisible}}"
    placement="bottom"
    bind:visible-change="onTipsPopupVisibleChange"
  >
    <view class="tips-popup">
      <view class="tips-popup-title">✨ AI 小贴士</view>
      <view class="tips-popup-dish">{{dish.name}}</view>
      <t-textarea
        value="{{tipsQuestion}}"
        placeholder="想了解什么？（可跳过）如：没有料酒用什么替代"
        maxlength="100"
        autosize
        bind:change="onTipsQuestionInput"
      />
      <view wx:if="{{tipsGenerating}}" class="ai-tip">生成中，约 5-15 秒…</view>
      <view wx:if="{{tipsGenerating && tipsStream}}" class="tips-stream">{{tipsStream}}▍</view>
      <view wx:if="{{tipsError}}" class="tips-error">{{tipsError}}</view>
      <view wx:if="{{tipsResult}}" class="tips-result">{{tipsResult}}</view>
      <view class="tips-popup-btns">
        <t-button class="action-btn" variant="outline" size="small" bind:tap="onTipsClose">关闭</t-button>
        <t-button class="action-btn" theme="primary" size="small" loading="{{tipsGenerating}}" bind:tap="onTipsGenerate">{{tipsResult ? '再问一个' : '生成'}}</t-button>
      </view>
    </view>
  </t-popup>

  <!-- 统一轻提示 -->
  <t-toast id="t-toast" />
</view>
